{
  "name": "tauri-docs-mcp",
  "version": "0.1.0",
  "description": "Read-only MCP search server for official Tauri 2 documentation.",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
